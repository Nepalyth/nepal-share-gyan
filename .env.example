# Copy to .env (never commit it). Quote values that contain # or spaces.
# Depository participant: the 5-digit DP code (or exact name) shown on the MeroShare login page.
MEROSHARE_DP=""
MEROSHARE_USERNAME=""
MEROSHARE_PASSWORD=""
# Optional: your CRN, used by the Apply IPO tab.
MEROSHARE_CRN=""

# WhatsApp alerts for newly opened IPOs/debentures via Twilio (see README).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Optional: defaults to the Twilio sandbox number whatsapp:+14155238886.
TWILIO_WHATSAPP_FROM=""
# Recipients in international format, no +, comma-separated, e.g. 9779812345678,9779898765432.
WHATSAPP_PHONE=""
